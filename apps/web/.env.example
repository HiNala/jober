# FastAPI backend (browser-reachable host/port)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical site URL for sitemap, OG metadata (optional in local dev)
# NEXT_PUBLIC_SITE_URL=https://jober.app

# Google OAuth UI (set true when API has GOOGLE_CLIENT_ID / secret configured)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
