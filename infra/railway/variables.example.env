# Railway variable template — copy values into each service via dashboard or CLI.
# Never commit real secrets. Use ${{Service.VAR}} references where noted.

# --- Shared / API ---
JOBER_ENV=production
LOG_MODE=redacted
REQUIRE_SECRETS=true
AUTH_MODE=native
DEV_AUTH_BYPASS=false
COOKIE_SECURE=true

# Postgres (managed) — prefix asyncpg driver for SQLAlchemy:
# postgresql+asyncpg://user:pass@host:port/railway
DATABASE_URL=${{Postgres.DATABASE_URL}}
# If Railway provides postgresql:// only, rewrite to postgresql+asyncpg://

REDIS_URL=${{Redis.REDIS_URL}}
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}

# MinIO on private network (self-hosted) OR Railway bucket credentials:
MINIO_ENDPOINT=${{minio.RAILWAY_PRIVATE_DOMAIN}}:9000
MINIO_ACCESS_KEY=<sealed>
MINIO_SECRET_KEY=<sealed>
MINIO_BUCKET=jober-artifacts
MINIO_SECURE=false
# Railway native buckets: set from `railway bucket credentials --json`
# MINIO_REGION=auto
# MINIO_SECURE=true

SECRET_KEY=<sealed>
VAULT_ENCRYPTION_KEY=<sealed>
LLM_API_KEY=<sealed>
ADMIN_BOOTSTRAP_SECRET=<sealed>
LLM_MONTHLY_BUDGET_USD=25
LLM_BUDGET_SOFT_WARN_RATIO=0.8

# Observability (Mission 24)
LOG_FORMAT=json
OPS_ALERT_WEBHOOK_URL=<incoming-webhook-url>
OPS_ALERT_COOLDOWN_SECONDS=900
SENTRY_DSN=

# Public browser URL for the web app (custom domain or Railway domain)
WEB_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Transactional email (verification + password reset) — API + worker
EMAIL_BACKEND=smtp
EMAIL_FROM=Jober <noreply@yourdomain.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=<resend-smtp-password>
SMTP_USE_TLS=true

# Google OAuth redirect must match the public API domain
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# --- Web (build-time + runtime) ---
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com

# --- Worker ---
JOBER_ENV=production
PLAYWRIGHT_HEADED=false
CELERY_WORKER_CONCURRENCY=2
BROWSERLESS_URL=
