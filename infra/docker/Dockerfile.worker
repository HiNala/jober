# syntax=docker/dockerfile:1

FROM python:3.12-slim AS builder

WORKDIR /build
COPY packages/schemas /build/packages/schemas
COPY packages/extraction /build/packages/extraction
COPY packages/forms /build/packages/forms
COPY packages/fill /build/packages/fill
COPY packages/verification /build/packages/verification
COPY packages/recovery /build/packages/recovery
COPY apps/api /build/apps/api
COPY apps/worker /build/apps/worker
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --prefix=/install \
        /build/packages/schemas \
        /build/packages/extraction \
        /build/packages/forms \
        /build/packages/fill \
        /build/packages/verification \
        /build/packages/recovery \
        /build/apps/api \
        /build/apps/worker

FROM python:3.12-slim AS runtime

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libdbus-1-3 \
        libxkbcommon0 \
        libatspi2.0-0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
        fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 jober \
    && useradd --uid 1000 --gid jober --create-home jober \
    && mkdir -p /ms-playwright \
    && chown -R jober:jober /ms-playwright

COPY --from=builder /install /usr/local
WORKDIR /app

USER jober
RUN playwright install chromium

USER root
COPY infra/docker/worker-entrypoint.sh /app/worker-entrypoint.sh
RUN sed -i 's/\r$//' /app/worker-entrypoint.sh \
    && chmod +x /app/worker-entrypoint.sh \
    && chown jober:jober /app/worker-entrypoint.sh

USER jober
EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=10s --retries=5 --start-period=90s \
    CMD sh -c 'curl -fsS "http://127.0.0.1:${PORT:-8080}/readyz" || exit 1'

ENTRYPOINT ["/app/worker-entrypoint.sh"]
