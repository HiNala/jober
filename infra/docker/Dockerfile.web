# syntax=docker/dockerfile:1

# Dev image for apps/web (Next.js). Source is bind-mounted at runtime (see
# compose.yaml) so edits hot-reload; this image only provides Node + a
# Linux-native node_modules so the host's Windows node_modules never leaks in.
FROM node:22-slim

WORKDIR /app

RUN npm install -g pnpm@10

# Install deps from the lockfile so node_modules is reproducible and built for
# Linux. A named volume shadows /app/node_modules at runtime to preserve it.
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

EXPOSE 3000

CMD ["pnpm", "exec", "next", "dev", "-H", "0.0.0.0", "-p", "3000"]
