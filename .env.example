# Database
DATABASE_URL=postgresql+asyncpg://jober:jober@postgres:5432/jober?ssl=disable

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=jober-artifacts
MINIO_SECURE=false

# Web (local Next.js — browser must reach the API host)
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# Production / Railway — comma-separated browser origins allowed by the API
# CORS_ORIGINS=https://app.example.com

# API
SECRET_KEY=
ADMIN_BOOTSTRAP_SECRET=
AUTH_MODE=native
WEB_APP_URL=http://localhost:3000

# Transactional email (Mission 11) — console logs locally; smtp for real inboxes
EMAIL_BACKEND=console
EMAIL_FROM=Jober <noreply@localhost>
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

JOBER_ENV=development
LOG_MODE=redacted
PRESIGNED_URL_TTL_MINUTES=15
REQUIRE_SECRETS=false
API_HOST=0.0.0.0
API_PORT=8000

# Optional host port overrides when defaults are already in use locally
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
MINIO_API_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=
API_HOST_PORT=

# LLM gateway (Mission 05+ — leave LLM_API_KEY empty to use the template provider locally)
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_DRAFT_MODEL=gpt-4o-mini
LLM_SCORING_MODEL=gpt-4o-mini
LLM_MONTHLY_BUDGET_USD=25

# Google OAuth (Mission 21 — optional; leave empty to hide provider buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
OAUTH_STATE_TTL_SECONDS=600

# Profile vault encryption
VAULT_ENCRYPTION_KEY=

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Batch ops (Mission 13 — defaults are safe for local dev)
BATCH_MAX_CONCURRENCY=1
BATCH_SITE_COOLDOWN_SECONDS=30
BATCH_ACTION_DELAY_MS=500
BATCH_TICK_SECONDS=5
CELERY_WORKER_CONCURRENCY=2
RUN_ARTIFACT_RETENTION_DAYS=90

# Observability / alerts (production)
LOG_FORMAT=text
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=900
SENTRY_DSN=
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
QUIET_HOURS_TIMEZONE=UTC
AUTO_SUBMIT_OPT_IN=false

# Optional host port overrides (when defaults conflict with other local stacks)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
