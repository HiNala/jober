# Database
DATABASE_URL=postgresql+asyncpg://jober:jober@postgres:5432/jober?ssl=disable

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=jober-artifacts
MINIO_SECURE=false

# API
SECRET_KEY=
API_HOST=0.0.0.0
API_PORT=8000

# Optional host port overrides when defaults are already in use locally
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
MINIO_API_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=
API_HOST_PORT=

# LLM providers (set at least one for later missions)
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=
LLM_MONTHLY_BUDGET_USD=

# Profile vault encryption
VAULT_ENCRYPTION_KEY=

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Optional host port overrides (when defaults conflict with other local stacks)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
